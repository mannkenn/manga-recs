# Patterns for project-root directories are anchored with a leading slash.
# Unanchored, a name like `data/` matches at every depth and would silently
# ignore the `src/manga_recs/data/` package.

# ide settings
.vscode/

# venv
/venv/
/.venv/
/env/

# byte-code
__pycache__/

# env vars
.env
.env.*
!.env.example

# local runtime config
/configs/local.toml

# dist
*.egg-info/
/build/
/dist/

# mlops
/mlflow.db
/mlruns/
/artifacts/

# experimentation
/notebooks/

# generated data artifacts
/data/

# test + lint caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# airflow local state
/airflow/logs/
/airflow/plugins/
