# Copy to .env and fill in. Never commit .env.
#
# Credentials for the S3-compatible object store. The variable names are the
# standard AWS ones because every S3-compatible provider reuses them.

# --- Local MinIO (docker compose up -d minio minio-init) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MANGA_RECS_S3_ENDPOINT_URL=http://localhost:9000
MANGA_RECS_S3_BUCKET=manga-recs

# --- Cloudflare R2 ---
# AWS_ACCESS_KEY_ID=<r2-access-key-id>
# AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
# AWS_DEFAULT_REGION=auto
# MANGA_RECS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MANGA_RECS_S3_BUCKET=manga-recs

# --- AWS S3 ---
# AWS_ACCESS_KEY_ID=<aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# AWS_DEFAULT_REGION=us-east-1
# MANGA_RECS_S3_BUCKET=manga-recs
# (leave MANGA_RECS_S3_ENDPOINT_URL unset for AWS)

# --- API ---
# Comma-separated CORS allowlist for the deployed frontend.
# MANGA_RECS_CORS_ORIGINS=https://your-app.vercel.app
